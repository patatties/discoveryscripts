  --accent: #2563eb;
  --secure: #16a34a;
  --secure-bg: #dcfce7;
  --partial: #b45309;
  --partial-bg: #fef3c7;
  --insecure: #dc2626;
  --insecure-bg: #fee2e2;
  --unknown: #6b7280;
  --unknown-bg: #e5e7eb;
}
